@model TalentDesk.Models.ConvitesViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Convites";
    ViewData["Menu"] = "convites";
}

<section class="convites">
    <header class="secao-cabecalho">
        <h2>Convites de administrador</h2>
        <p>Gere um link de uso único para o cliente criar a conta de administrador. Use o nome de uma empresa existente para adicionar mais um administrador a ela. O link vale por 7 dias.</p>
    </header>

    <div class="form-card convite-novo">
        <form method="post" asp-action="Criar" class="convite-form">
            <label class="campo">
                <span>E-mail do cliente</span>
                <input asp-for="Form.Email" type="email" placeholder="cliente@empresa.com.br" autocomplete="off" />
                <span asp-validation-for="Form.Email" class="erro"></span>
            </label>
            <label class="campo">
                <span>Empresa</span>
                <input asp-for="Form.Empresa" list="empresasExistentes" placeholder="Nova ou existente" autocomplete="off" />
                <span asp-validation-for="Form.Empresa" class="erro"></span>
            </label>
            <datalist id="empresasExistentes">
                @foreach (var empresa in Model.Empresas) { <option value="@empresa"></option> }
            </datalist>
            <button type="submit" class="btn btn-primary btn-lg">Gerar link</button>
        </form>

        @if (Model.LinkGerado is string link)
        {
            <div class="convite-gerado" role="status">
                <p><strong>Link gerado para @Model.EmailGerado.</strong> Copie e envie ao cliente agora: ele não poderá ser exibido de novo.</p>
                <div class="convite-link">
                    <input id="linkConvite" type="text" value="@link" readonly aria-label="Link do convite" />
                    <button type="button" class="btn btn-outline" data-copiar="#linkConvite">Copiar</button>
                </div>
            </div>
        }
    </div>

    <div class="form-card">
        <h3 class="convites-titulo">Últimos convites</h3>
        @if (Model.Convites.Count == 0)
        {
            <p class="painel-texto">Nenhum convite gerado ainda.</p>
        }
        else
        {
            <table class="tabela">
                <thead>
                    <tr>
                        <th>E-mail</th>
                        <th>Empresa</th>
                        <th>Criado em</th>
                        <th>Expira em</th>
                        <th>Situação</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var convite in Model.Convites)
                    {
                        string classe = convite.Usado ? "status-aprovado" : convite.Expirado ? "status-reprovado" : "status-analise";
                        <tr>
                            <td data-rotulo="E-mail">@convite.Email</td>
                            <td data-rotulo="Empresa">@(convite.EmpresaNome ?? "—")</td>
                            <td data-rotulo="Criado em">@convite.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                            <td data-rotulo="Expira em">@convite.ExpiraEm.ToString("dd/MM/yyyy HH:mm")</td>
                            <td data-rotulo="Situação"><span class="status @classe">@convite.Situacao</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>
