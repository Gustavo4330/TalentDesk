@model TalentDesk.Models.LoginViewModel
@{
    ViewData["Title"] = "Login e cadastro";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #5b21b6;
            --primary-dark: #351b5e;
            --primary-soft: #eee5ff;
            --bg: #f5f2fc;
            --panel: #ffffff;
            --border: #e5e7eb;
            --text: #1f1b3d;
            --muted: #706987;
            --danger: #dc2626;
            --success: #166534;
            --shadow: rgba(53, 27, 94, 0.1);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: radial-gradient(ellipse at 80% 0%, rgba(224, 186, 255, .3), transparent 34%), linear-gradient(135deg, #f5f2fc 0%, #fbfaff 100%);
            color: var(--text);
        }

        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
        }

        .auth-layout {
            width: min(760px, 100%);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .auth-card {
            background: rgba(255,255,255,0.92);
            border: 1px solid rgba(91,33,182,0.08);
            border-radius: 28px;
            box-shadow: 0 24px 60px var(--shadow);
            padding: 32px 28px;
        }

        .brand-box {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            color: var(--primary);
            margin-bottom: 28px;
        }

        .brand-icon {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: grid;
            place-items: center;
            color: #fff;
            box-shadow: 0 14px 30px rgba(91, 33, 182, 0.22);
        }

        .brand-icon svg {
            width: 24px;
            height: 24px;
            fill: currentColor;
        }

        .brand-icon { overflow: hidden; background: #06122d; }
        .brand-icon .brand-logo { width: 100%; height: 100%; object-fit: cover; display: block; }

        .brand-box h1 {
            margin: 0;
            font-size: clamp(2rem, 2vw, 2.4rem);
            font-weight: 800;
            line-height: 1.1;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .auth-header h2 {
            margin: 0 0 8px;
            font-size: clamp(1.8rem, 1.8vw, 2.3rem);
            font-weight: 800;
        }

        .auth-header p {
            margin: 0;
            font-size: 0.96rem;
            color: var(--muted);
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.8rem;
            color: var(--muted);
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .input-field {
            width: 100%;
            min-height: 48px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: #fff;
            padding: 0 14px;
            color: var(--text);
            font-size: 0.97rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .input-field:focus {
            border-color: rgba(91,33,182,0.62);
            box-shadow: 0 0 0 4px rgba(91,33,182,0.08);
        }

        .data-nascimento { position: relative; }
        .data-nascimento-controle { position: relative; }
        .data-nascimento-texto { padding-right: 48px; cursor: pointer; }
        .data-nascimento-abrir {
            position: absolute; top: 5px; right: 5px; width: 38px; height: 38px;
            display: grid; place-items: center; border: 0; border-radius: 9px;
            background: var(--primary-soft); color: var(--primary); cursor: pointer;
        }
        .data-nascimento-abrir:hover { background: #ddd6fe; }
        .data-nascimento-abrir svg { width: 19px; height: 19px; fill: currentColor; }
        .calendario-nascimento {
            position: absolute; z-index: 20; top: calc(100% + 8px); left: 0; width: 320px;
            padding: 16px; border: 1px solid #e8e3f2; border-radius: 18px;
            background: #fff; box-shadow: 0 18px 45px rgba(40, 24, 75, .18);
        }
        .calendario-nascimento[hidden] { display: none; }
        .calendario-topo { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
        .calendario-mes { font-size: .95rem; font-weight: 800; text-transform: capitalize; }
        .calendario-mes { padding: 0; margin: 0; border: 0; background: transparent; color: var(--text); cursor: pointer; font: inherit; font-size: .95rem; font-weight: 800; text-transform: capitalize; }
        .calendario-mes:hover { color: var(--primary); }
        .calendario-nav { display: flex; gap: 6px; }
        .calendario-nav button { width: 32px; height: 32px; border: 1px solid var(--border); border-radius: 9px; background: white; color: var(--text); font-size: 1.15rem; }
        .calendario-grade { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center; }
        .calendario-dia-semana { padding: 5px 0; color: var(--muted); font-size: .7rem; font-weight: 700; }
        .calendario-dia { aspect-ratio: 1; border: 0; border-radius: 9px; background: transparent; color: var(--text); font-size: .82rem; }
        .calendario-dia:hover { background: var(--primary-soft); color: var(--primary-dark); }
        .calendario-dia.selecionado { background: linear-gradient(180deg, var(--primary), var(--primary-dark)); color: white; font-weight: 800; }
        .calendario-dia.hoje:not(.selecionado) { box-shadow: inset 0 0 0 1px #c4b5fd; color: var(--primary); font-weight: 800; }
        .calendario-anos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; max-height: 240px; overflow-y: auto; }
        .calendario-ano { min-height: 42px; border: 1px solid #eeeaf5; border-radius: 10px; background: #fff; color: var(--text); font-weight: 700; cursor: pointer; }
        .calendario-ano:hover, .calendario-ano.selecionado { border-color: #c4b5fd; background: var(--primary-soft); color: var(--primary); }
        .calendario-rodape { display: flex; justify-content: space-between; margin-top: 12px; padding-top: 10px; border-top: 1px solid #f0edf5; }
        .calendario-rodape button { border: 0; background: transparent; color: var(--primary); font-size: .8rem; font-weight: 700; cursor: pointer; }
        .data-nascimento-texto:focus-visible, .data-nascimento-abrir:focus-visible, .calendario-nascimento button:focus-visible { outline: 3px solid rgba(91,33,182,.25); outline-offset: 2px; }

        .field-validation-error, .validation-summary-errors {
            display: block;
            color: var(--danger);
            font-size: 0.78rem;
            margin-top: 7px;
            font-weight: 600;
        }

        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors ul {
            margin: 0 0 12px;
            padding-left: 18px;
        }

        .submit-button {
            width: 100%;
            min-height: 52px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: #fff;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 14px 26px rgba(91,33,182,0.22);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .submit-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 30px rgba(91,33,182,0.26);
        }

        .secondary-link {
            margin-top: 18px;
            text-align: center;
            color: var(--muted);
            font-size: 0.92rem;
        }

        .secondary-link a {
            color: var(--primary);
            font-weight: 700;
            text-decoration: none;
        }

        .status-box {
            margin-top: 20px;
            padding: 12px 14px;
            border-radius: 12px;
            background: #ecfdf5;
            color: var(--success);
            border: 1px solid rgba(22, 101, 52, 0.18);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .switcher {
            display: flex;
            gap: 8px;
            background: var(--primary-soft);
            border-radius: 12px;
            padding: 8px;
            margin-bottom: 24px;
        }

        .switcher a {
            text-decoration: none;
            flex: 1;
            text-align: center;
            border-radius: 10px;
            padding: 10px 12px;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .switcher a.active {
            background: var(--panel);
            box-shadow: 0 2px 8px rgba(91,33,182,0.08);
        }

        .muted-text {
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.5;
        }

        @@media (max-height: 850px) {
            .auth-shell {
                min-height: 100vh;
                align-items: flex-start;
                padding-top: 12px;
                padding-bottom: 12px;
            }

            .auth-card { padding-top: 22px; padding-bottom: 22px; }
            .brand-box { margin-bottom: 14px; }
            .brand-icon { width: 46px; height: 46px; border-radius: 14px; }
            .brand-box h1 { font-size: 1.8rem; }
            .auth-header { margin-bottom: 14px; }
            .auth-header h2 { font-size: 1.65rem; }
            .form-group { margin-bottom: 10px; }
            .form-group label { margin-bottom: 4px; }
            .input-field { min-height: 42px; }
            .data-nascimento-abrir { top: 3px; right: 3px; width: 36px; height: 36px; }
            .submit-button { min-height: 46px; }
            .secondary-link { margin-top: 12px; }
            .calendario-nascimento { top: auto; bottom: calc(100% + 8px); }
        }

        @@media (max-width: 480px) {
            .auth-shell { padding-left: 14px; padding-right: 14px; }
            .auth-card { width: 100%; padding-left: 20px; padding-right: 20px; }
        }
    </style>
}

<style>
    @@media (max-width: 900px) {
        .auth-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="auth-shell">
    <div class="auth-layout">
        <div class="auth-card" id="cadastro">
            <div class="brand-box">
                <div class="brand-icon">
                    <img class="brand-logo" src="~/images/logo-talentdesk.jpeg" asp-append-version="true" alt="" />
                </div>
                <h1>Talent<br />Desk</h1>
            </div>

            <div class="auth-header">
                <h2>Criar conta</h2>
                <p>cadastre-se e venha fazer parte do Talent Desk</p>
            </div>

            <form asp-controller="Usuario" asp-action="Cadastro" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>

                <div class="form-group">
                    <label asp-for="Nome">Nome</label>
                    <input asp-for="Nome" class="input-field" placeholder="Digite seu nome" />
                    <span asp-validation-for="Nome" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">E-mail</label>
                    <input asp-for="Email" class="input-field" type="email" placeholder="Digite seu e-mail" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Senha">Senha</label>
                    <input asp-for="Senha" class="input-field" type="password" placeholder="Digite sua senha" />
                    <span asp-validation-for="Senha" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Whatsapp">WhatsApp</label>
                    <input asp-for="Whatsapp" class="input-field" placeholder="Digite seu WhatsApp" />
                    <span asp-validation-for="Whatsapp" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DataNascimento">Data de nascimento</label>
                    <div class="data-nascimento" data-date-picker>
                        <input asp-for="DataNascimento" type="hidden" value="@(Model.DataNascimento?.ToString("yyyy-MM-dd"))" data-date-value />
                        <div class="data-nascimento-controle">
                            <input class="input-field data-nascimento-texto" type="text" placeholder="DD/MM/AAAA" readonly data-date-display aria-haspopup="dialog" aria-expanded="false" />
                            <button class="data-nascimento-abrir" type="button" aria-label="Abrir calendário" data-date-toggle>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V3a1 1 0 0 1 1-1Zm12 8H5v9h14v-9ZM5 6v2h14V6H5Z"/></svg>
                            </button>
                        </div>
                        <div class="calendario-nascimento" role="dialog" aria-label="Escolha a data de nascimento" hidden data-date-calendar></div>
                    </div>
                    <span asp-validation-for="DataNascimento" class="field-validation-error"></span>
                </div>

                <button type="submit" class="submit-button">Criar conta</button>
            </form>

            <div class="secondary-link">
                <a asp-controller="Curriculo" asp-action="Index">Voltar para a página inicial</a>
            </div>

            @if (TempData["MensagemSucesso"] != null)
            {
                <div class="status-box">
                    @TempData["MensagemSucesso"]
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const picker = document.querySelector('[data-date-picker]');
            if (!picker) return;
            const value = picker.querySelector('[data-date-value]');
            const display = picker.querySelector('[data-date-display]');
            const calendar = picker.querySelector('[data-date-calendar]');
            const toggle = picker.querySelector('[data-date-toggle]');
            const weekdays = ['D', 'S', 'T', 'Q', 'Q', 'S', 'S'];
            const today = new Date(); today.setHours(0, 0, 0, 0);
            const minYear = 1900;
            const parseDate = text => {
                const parts = text.slice(0, 10).split('-').map(Number);
                return parts.length === 3 ? new Date(parts[0], parts[1] - 1, parts[2]) : new Date(today.getFullYear(), today.getMonth(), 1);
            };
            let view = value.value ? parseDate(value.value) : new Date(today.getFullYear(), today.getMonth(), 1);
            let viewMode = 'days';
            let yearPage = Math.floor(view.getFullYear() / 10) * 10;

            const iso = date => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
            const updateDisplay = () => {
                display.value = value.value ? parseDate(value.value).toLocaleDateString('pt-BR') : '';
            };
            const render = () => {
                const year = view.getFullYear(), month = view.getMonth();
                if (viewMode === 'years') {
                    const lastYear = Math.min(yearPage + 9, today.getFullYear());
                    calendar.innerHTML = `<div class="calendario-topo"><strong class="calendario-mes">Escolha o ano</strong><div class="calendario-nav"><button type="button" aria-label="Década anterior" data-year-page="-1">‹</button><button type="button" aria-label="Próxima década" data-year-page="1" ${yearPage + 10 > today.getFullYear() ? 'disabled' : ''}>›</button></div></div><div class="calendario-anos">${Array.from({length: Math.max(0, lastYear - yearPage + 1)}, (_, i) => { const yearOption = yearPage + i; return `<button type="button" class="calendario-ano ${yearOption === year ? 'selecionado' : ''}" data-year="${yearOption}" aria-pressed="${yearOption === year}">${yearOption}</button>`; }).join('')}</div>`;
                    return;
                }
                if (viewMode === 'months') {
                    const months = Array.from({length: 12}, (_, i) => new Date(year, i, 1).toLocaleDateString('pt-BR', { month: 'long' }));
                    calendar.innerHTML = `<div class="calendario-topo"><strong class="calendario-mes">Escolha o mês</strong><div class="calendario-nav"><button type="button" aria-label="Voltar ao calendário" data-back-days>×</button></div></div><div class="calendario-anos">${months.map((name, i) => `<button type="button" class="calendario-ano ${i === month ? 'selecionado' : ''}" data-month-pick="${i}">${name}</button>`).join('')}</div>`;
                    return;
                }
                const first = new Date(year, month, 1).getDay();
                const days = new Date(year, month + 1, 0).getDate();
                const focusDay = value.value && value.value.startsWith(`${year}-${String(month + 1).padStart(2, '0')}`) ? Number(value.value.slice(-2)) : Math.min(today.getDate(), days);
                calendar.innerHTML = `<div class="calendario-topo"><button type="button" class="calendario-mes" data-show-months>${view.toLocaleDateString('pt-BR', { month: 'long' })}</button><button type="button" class="calendario-mes" data-show-years>${year}</button><div class="calendario-nav"><button type="button" aria-label="Mês anterior" data-month="-1" ${year === minYear && month === 0 ? 'disabled' : ''}>‹</button><button type="button" aria-label="Próximo mês" data-month="1" ${year === today.getFullYear() && month === today.getMonth() ? 'disabled' : ''}>›</button></div></div><div class="calendario-grade">${weekdays.map(day => `<span class="calendario-dia-semana">${day}</span>`).join('')}${Array(first).fill('<span></span>').join('')}${Array.from({length: days}, (_, i) => { const date = new Date(year, month, i + 1); const key = iso(date); const disabled = date > today; const classes = ['calendario-dia', key === value.value ? 'selecionado' : '', key === iso(today) ? 'hoje' : ''].filter(Boolean).join(' '); return `<button type="button" class="${classes}" data-day="${key}" aria-pressed="${key === value.value}" ${disabled ? 'disabled' : ''} tabindex="${i + 1 === focusDay && !disabled ? '0' : '-1'}">${i + 1}</button>`; }).join('')}</div><div class="calendario-rodape"><button type="button" data-clear>Limpar</button><button type="button" data-today>Hoje</button></div>`;
            };
            const open = () => { render(); calendar.hidden = false; display.setAttribute('aria-expanded', 'true'); };
            const close = () => { calendar.hidden = true; display.setAttribute('aria-expanded', 'false'); };
            updateDisplay();
            toggle.addEventListener('click', () => calendar.hidden ? open() : close());
            display.addEventListener('click', open);
            calendar.addEventListener('click', event => {
                event.preventDefault();
                event.stopPropagation();
                const monthButton = event.target.closest('[data-month]');
                const dayButton = event.target.closest('[data-day]');
                if (event.target.closest('[data-show-years]')) { viewMode = 'years'; yearPage = Math.floor(view.getFullYear() / 10) * 10; render(); return; }
                if (event.target.closest('[data-show-months]')) { viewMode = 'months'; render(); return; }
                if (event.target.closest('[data-back-days]')) { viewMode = 'days'; render(); return; }
                const yearPageButton = event.target.closest('[data-year-page]');
                if (yearPageButton) { yearPage = Math.max(minYear, Math.min(today.getFullYear(), yearPage + Number(yearPageButton.dataset.yearPage) * 10)); render(); return; }
                const yearButton = event.target.closest('[data-year]');
                if (yearButton) { view = new Date(Number(yearButton.dataset.year), view.getMonth(), 1); viewMode = 'days'; render(); return; }
                const monthPick = event.target.closest('[data-month-pick]');
                if (monthPick) { const selectedMonth = Number(monthPick.dataset.monthPick); if (view.getFullYear() === today.getFullYear() && selectedMonth > today.getMonth()) return; view = new Date(view.getFullYear(), selectedMonth, 1); viewMode = 'days'; render(); return; }
                if (monthButton) { const next = new Date(view.getFullYear(), view.getMonth() + Number(monthButton.dataset.month), 1); if (next >= new Date(minYear, 0, 1) && next <= today) view = next; render(); return; }
                if (dayButton) { value.value = dayButton.dataset.day; updateDisplay(); value.dispatchEvent(new Event('change', { bubbles: true })); close(); }
                if (event.target.closest('[data-clear]')) { value.value = ''; updateDisplay(); value.dispatchEvent(new Event('change', { bubbles: true })); close(); }
                if (event.target.closest('[data-today]')) { value.value = iso(today); view = new Date(today.getFullYear(), today.getMonth(), 1); viewMode = 'days'; updateDisplay(); value.dispatchEvent(new Event('change', { bubbles: true })); close(); }
            });
            calendar.addEventListener('keydown', event => {
                if (event.key === 'Escape') { event.preventDefault(); close(); toggle.focus(); return; }
                if (viewMode !== 'days' || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return;
                const activeDay = event.target.closest('[data-day]');
                if (!activeDay) return;
                event.preventDefault(); event.stopPropagation();
                const delta = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : event.key === 'ArrowUp' ? -7 : 7;
                const next = new Date(parseDate(activeDay.dataset.day)); next.setDate(next.getDate() + delta);
                if (next <= today) { view = new Date(next.getFullYear(), next.getMonth(), 1); render(); calendar.querySelector(`[data-day="${iso(next)}"]`)?.focus(); }
            });
            document.addEventListener('click', event => { if (!picker.contains(event.target)) close(); });
            document.addEventListener('keydown', event => { if (event.key === 'Escape' && !calendar.hidden) { close(); toggle.focus(); } });
        })();
    </script>
}
